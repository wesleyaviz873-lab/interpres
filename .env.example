# ---------------------------------------------------------------------------
# Interpres configuration
# Copy this file to .env and fill the values. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL used in links, cookies, and tunnel instructions.
APP_URL=http://localhost:3000

# Random secret used to encrypt stored provider keys and sign short-lived
# tokens. Production refuses to start with the default or anything under 32
# characters. Generate with: openssl rand -hex 32
APP_SECRET=change-me

# Environment: development | production
APP_ENV=production

# Execution mode: local | server
# local  = desktop, terminal, emulator, and local agent features are available
# server = only chat, providers, workspace, and explicitly enabled tools
APP_MODE=server

# Database. SQLite is the default; PostgreSQL is optional.
DATABASE_URL=sqlite:////data/interpres.db
# DATABASE_URL=postgresql+psycopg://interpres:change-me@db:5432/interpres

# Directory the AI is allowed to read and write.
WORKSPACE_DIR=/workspace

# Runtime data: database, job events, uploads, audit log.
DATA_DIR=/data

# Built frontend served by the API in production.
WEB_DIST_DIR=/app/web/dist

# Host port for Docker Compose (the container always listens on 8000).
INTERPRES_PORT=3000

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Rate limits for login attempts.
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MINUTES=15

# Optional: allow account creation only on first run.
ALLOW_SIGNUP=false

# Optional: log level.
LOG_LEVEL=info

# Optional: outbound local agent endpoint. Leave empty to disable.
AGENT_PAIRING_ENABLED=false

# Optional: tunnel profile.
# CLOUDFLARE_TUNNEL_TOKEN=
